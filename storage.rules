rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read for website media
    match /{allPaths=**} {
      allow read: if true;
    }

    // Authenticated upload for staff & admins with image type & 8MB limit
    match /tours/{allPaths=**} {
      allow write: if request.auth != null &&
                     request.resource.size < 8 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }

    match /cms/{allPaths=**} {
      allow write: if request.auth != null &&
                     request.resource.size < 8 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }
  }
}
