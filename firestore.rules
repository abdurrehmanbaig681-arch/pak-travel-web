rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has admin role
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper function to check if user has staff or admin role
    function isStaffOrAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role in ['admin', 'staff'] || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff']);
    }

    // Public site settings: readable by everyone, editable by staff/admin
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Tours collection: published tours readable by anyone, all editable by staff/admin
    match /tours/{tourId} {
      allow read: if resource.data.status == 'published' || isStaffOrAdmin();
      allow write: if isStaffOrAdmin();
    }

    // Past tours portfolio
    match /past_tours/{pastTourId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Destinations & categories
    match /destinations/{destId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Booking Requests: public can create with valid data, only staff/admin can read or update
    match /bookings/{bookingId} {
      allow create: if request.resource.data.fullName != null &&
                      request.resource.data.phone != null &&
                      request.resource.data.tourId != null;
      allow read, update, delete: if isStaffOrAdmin();
    }

    // Custom Tour Requests: public can submit, staff/admin can manage
    match /custom_tour_requests/{requestId} {
      allow create: if request.resource.data.fullName != null &&
                      request.resource.data.phone != null;
      allow read, update, delete: if isStaffOrAdmin();
    }

    // Contact form / general enquiries
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.fullName != null &&
                      request.resource.data.email != null;
      allow read, update, delete: if isStaffOrAdmin();
    }

    // User profiles & roles: users can read their own profile; admins can manage all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Activity audit logs: staff/admin can read; append-only
    match /activity_logs/{logId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      allow update, delete: if false; // immutable audit log
    }
  }
}
